@model NguyenTanPhu_23DH114527.Models.Product
@{
    var quantity = ViewData["Quantity"] as int? ?? 1;
    quantity = Math.Max(1, Math.Min(quantity, Math.Max(1, Model.Quantity)));
}

@if (Model.Quantity > 0)
{
    using (Html.BeginForm("AddToCart", "Cart", new { area = "" }, FormMethod.Post, new { @class = "buy-box" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="productId" value="@Model.ProductID" />
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <label for="quantity" class="fw-semibold mb-0">Số lượng</label>
            <div class="qty-control">
                <button type="button" data-step="-1" aria-label="Giảm">−</button>
                <input type="number" id="quantity" name="quantity" value="@quantity" min="1" max="@Model.Quantity" />
                <button type="button" data-step="1" aria-label="Tăng">+</button>
            </div>
            <span class="text-muted small">Còn @Model.Quantity sản phẩm</span>
        </div>
        <div class="mt-3">Tạm tính: <strong class="text-danger fs-5" id="subtotal" data-price="@Model.ProductPrice.ToString("0", System.Globalization.CultureInfo.InvariantCulture)">@((Model.ProductPrice * quantity).ToString("N0")) đ</strong></div>
        <div class="d-flex gap-2 mt-3 flex-wrap">
            <button type="submit" class="btn btn-outline-buy btn-lg">Thêm vào giỏ</button>
            <button type="submit" name="buyNow" value="true" class="btn btn-buy btn-lg">Mua ngay</button>
        </div>
    }
}
else
{
    <div class="alert alert-secondary mt-3">Sản phẩm tạm hết hàng.</div>
}
