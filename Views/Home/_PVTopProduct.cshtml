@model NguyenTanPhu_23DH114527.Models.ViewModel.ProductDetailVM
@using PagedList.Mvc

<section class="section-block" id="top-deals">
    <div class="section-head">
        <h2>Top Deals</h2>
        <span class="text-muted">Bán chạy nhất cùng danh mục</span>
    </div>
    @if (Model.TopProducts.TotalItemCount == 0)
    {
        <p class="text-muted">Chưa có sản phẩm.</p>
    }
    else
    {
        <div class="product-grid grid-3">
            @foreach (var p in Model.TopProducts)
            {
                @Html.Partial("~/Views/Shared/_ProductCard.cshtml", p)
            }
        </div>
        <div class="pager-wrap">
            @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetail", new { id = Model.Product.ProductID, page }) + "#top-deals")
        </div>
    }
</section>
