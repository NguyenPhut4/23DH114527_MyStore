@model NguyenTanPhu_23DH114527.Models.ViewModel.BookDetailVM
@using PagedList.Mvc

<section class="section-block" id="top-deals">
    <div class="section-head">
        <h2>Top Deals</h2>
        <span class="text-muted">Bán chạy nhất cùng danh mục</span>
    </div>
    @if (Model.TopBooks.TotalItemCount == 0)
    {
        <p class="text-muted">Chưa có sản phẩm.</p>
    }
    else
    {
        <div class="product-grid grid-3">
            @foreach (var p in Model.TopBooks)
            {
                @Html.Partial("~/Views/Shared/_BookCard.cshtml", p)
            }
        </div>
        <div class="pager-wrap">
            @Html.PagedListPager(Model.TopBooks, page => Url.Action("ProductDetail", new { id = Model.Book.BookId, page }) + "#top-deals")
        </div>
    }
</section>
