@model NguyenTanPhu_23DH114527.Models.ViewModel.ProfileVM
@{
    ViewBag.Title = "Thông tin tài khoản";
    var showPassword = ViewBag.ShowPasswordTab == true;
}

<h1 class="h3 mb-3">Thông tin tài khoản</h1>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="panel">
            <h2 class="h6 text-uppercase text-muted">Thông tin cá nhân</h2>
            <dl class="mb-0">
                <dt>Họ và tên</dt><dd>@Model.Profile.CustomerName</dd>
                <dt>Số điện thoại</dt><dd>@Model.Profile.CustomerPhone</dd>
                <dt>Email</dt><dd>@Model.Profile.CustomerEmail</dd>
                <dt>Địa chỉ</dt><dd>@Model.Profile.CustomerAddress</dd>
                <dt>Tên đăng nhập</dt><dd class="mb-0">@Model.Profile.Username</dd>
            </dl>
            <hr />
            @Html.ActionLink("Xem lịch sử mua hàng", "MyOrder", "Order", null, new { @class = "btn btn-outline-buy w-100" })
        </div>
    </div>
    <div class="col-lg-8">
        <div class="panel">
            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(showPassword ? "" : "active")" data-bs-toggle="tab" data-bs-target="#tabProfile" type="button" role="tab">Thay đổi thông tin</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(showPassword ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabPassword" type="button" role="tab">Đổi mật khẩu</button>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade @(showPassword ? "" : "show active")" id="tabProfile" role="tabpanel">
                    @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Profile.CustomerName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Profile.CustomerName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Profile.CustomerName, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Profile.CustomerPhone, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Profile.CustomerPhone, new { @class = "form-control", type = "tel" })
                                @Html.ValidationMessageFor(m => m.Profile.CustomerPhone, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Profile.CustomerEmail, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Profile.CustomerEmail, new { @class = "form-control", type = "email" })
                                @Html.ValidationMessageFor(m => m.Profile.CustomerEmail, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Profile.CustomerAddress, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Profile.CustomerAddress, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Profile.CustomerAddress, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <button type="submit" class="btn btn-buy mt-3">Lưu thông tin</button>
                    }
                </div>
                <div class="tab-pane fade @(showPassword ? "show active" : "")" id="tabPassword" role="tabpanel">
                    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="row g-3" style="max-width: 420px">
                            <div class="col-12">
                                @Html.LabelFor(m => m.ChangePassword.OldPassword, new { @class = "form-label" })
                                @Html.PasswordFor(m => m.ChangePassword.OldPassword, new { @class = "form-control", autocomplete = "current-password" })
                                @Html.ValidationMessageFor(m => m.ChangePassword.OldPassword, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-12">
                                @Html.LabelFor(m => m.ChangePassword.NewPassword, new { @class = "form-label" })
                                @Html.PasswordFor(m => m.ChangePassword.NewPassword, new { @class = "form-control", autocomplete = "new-password" })
                                @Html.ValidationMessageFor(m => m.ChangePassword.NewPassword, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-12">
                                @Html.LabelFor(m => m.ChangePassword.ConfirmPassword, new { @class = "form-label" })
                                @Html.PasswordFor(m => m.ChangePassword.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })
                                @Html.ValidationMessageFor(m => m.ChangePassword.ConfirmPassword, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <button type="submit" class="btn btn-buy mt-3">Đổi mật khẩu</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
