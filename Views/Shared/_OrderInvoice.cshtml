@model NguyenTanPhu_23DH114527.Models.Order
@* Hóa đơn mua hàng: dùng chung cho Admin (Orders/DetailedOrder) và Customer (OrderSuccess, OrderDetail) *@
@{
    var subTotal = Model.OrderItems.Sum(oi => oi.Quantity * oi.UnitPrice);
}

<div class="invoice">
    <div class="invoice-head">
        <div>
            <div class="invoice-brand"><svg class="brand-mark" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M3 9 L5 4 H19 L21 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M3 9 q2.25 3 4.5 0 q2.25 3 4.5 0 q2.25 3 4.5 0 q2.25 3 4.5 0" fill="none" stroke="#e85d04" stroke-width="2" stroke-linecap="round"/><path d="M6 12 V20 H18 V12 M10 20 v-5 h4 v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>Hiên <span>Sách</span></div>
            <div class="invoice-muted">Hiên Sách · Hotline 1900 1234</div>
        </div>
        <div class="text-md-end">
            <div class="invoice-title">HÓA ĐƠN MUA HÀNG</div>
            <div>Số: <strong>#@Model.OrderId</strong></div>
            <div>Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy")</div>
        </div>
    </div>

    <div class="invoice-parties">
        <div class="invoice-box">
            <div class="invoice-box-title">Người nhận</div>
            <div class="fw-semibold">@Model.ReceiverName</div>
            <div>SĐT: @Model.ReceiverPhone</div>
            <div>@Html.DisplayNameFor(m => m.ShippingAddress): @Model.ShippingAddress</div>
            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <div>Ghi chú: @Model.Note</div>
            }
        </div>
        <div class="invoice-box">
            <div class="invoice-box-title">Thanh toán &amp; giao hàng</div>
            <div>@Html.DisplayNameFor(m => m.PaymentMethod): @Model.PaymentMethodText</div>
            <div>@Html.DisplayNameFor(m => m.PaymentStatus): <strong>@Model.PaymentStatusText</strong></div>
            <div>@Html.DisplayNameFor(m => m.DeliveryMethod): @Model.DeliveryText</div>
            <div>@Html.DisplayNameFor(m => m.Status): <span class="invoice-status">@Model.StatusText</span></div>
        </div>
    </div>

    @Html.Partial("~/Views/Shared/_OrderDetailList.cshtml", Model.OrderItems)

    <div class="invoice-sums">
        <div><span>Tạm tính</span><span>@subTotal.ToString("N0") đ</span></div>
        <div><span>Phí vận chuyển</span><span>@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("N0") + " đ")</span></div>
        @if (Model.DiscountAmount > 0)
        {
            <div><span>Giảm giá@(Model.Coupon != null ? " (" + Model.Coupon.Code + ")" : "")</span><span>-@Model.DiscountAmount.ToString("N0") đ</span></div>
        }
    </div>
    <div class="invoice-total">
        <span>@Html.DisplayNameFor(m => m.TotalAmount)</span>
        <strong>@Model.TotalAmount.ToString("N0") đ</strong>
    </div>
</div>
