@model IEnumerable<NguyenTanPhu_23DH114527.Models.Product>
@* Slider ngang dung chung (San pham noi bat, San pham tuong tu) *@

@if (!Model.Any())
{
    <p class="text-muted">Chưa có sản phẩm.</p>
}
else
{
    <div class="product-slider" data-slider>
        <button type="button" class="slider-btn prev" data-dir="-1" aria-label="Trước">&#8249;</button>
        <div class="slider-track">
            @foreach (var p in Model)
            {
                <div class="slider-item">@Html.Partial("~/Views/Shared/_ProductCard.cshtml", p)</div>
            }
        </div>
        <button type="button" class="slider-btn next" data-dir="1" aria-label="Sau">&#8250;</button>
    </div>
}
