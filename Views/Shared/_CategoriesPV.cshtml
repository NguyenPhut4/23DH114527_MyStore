@model IEnumerable<NguyenTanPhu_23DH114527.Models.Category>
@* Menu danh mục 2 cấp: danh mục gốc là mục đậm, danh mục con thụt vào bên dưới *@

<ul class="navbar-nav category-menu">
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            Danh mục
        </a>
        <ul class="dropdown-menu">
            @foreach (var root in Model)
            {
                <li>@Html.ActionLink(root.CategoryName, "ProductList", "Home", new { area = "", id = root.CategoryId }, new { @class = "dropdown-item fw-semibold" })</li>
                foreach (var child in root.ChildCategories.OrderBy(c => c.CategoryName))
                {
                    <li>@Html.ActionLink("› " + child.CategoryName, "ProductList", "Home", new { area = "", id = child.CategoryId }, new { @class = "dropdown-item ps-4 small" })</li>
                }
            }
        </ul>
    </li>
</ul>
