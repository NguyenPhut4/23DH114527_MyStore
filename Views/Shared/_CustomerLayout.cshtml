<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FASTOR Books</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/myStyle/customer.css" rel="stylesheet" />
    <link href="~/Content/invoice.css" rel="stylesheet" />
    @RenderSection("styles", required: false)
</head>
<body class="customer">
    <header>
        <div class="topbar">
            <div class="container d-flex justify-content-between flex-wrap gap-2">
                <span>Miễn phí giao hàng cho đơn từ 300.000 đ</span>
                <span>Hotline: 1900 1234</span>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg main-nav">
            <div class="container">
                <a class="brand" href="@Url.Action("Index", "Home", new { area = "" })">FA<span>S</span>TOR</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @Html.Action("CategoryMenu", "Home", new { area = "" })
                    <form class="header-search my-2 my-lg-0 mx-lg-3" action="@Url.Action("Index", "Home", new { area = "" })" method="get" role="search">
                        <input class="form-control" type="search" name="searchTerm" placeholder="Tìm sách theo tên, mô tả, danh mục..."
                               value="@Request.QueryString["searchTerm"]" aria-label="Tìm kiếm" />
                        <button class="btn" type="submit" aria-label="Tìm kiếm">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
                        </button>
                    </form>
                    @Html.Action("PersonalMenu", "Home", new { area = "" })
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 customer-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <div class="brand brand-light mb-2">FA<span>S</span>TOR</div>
                    <p class="mb-0">Đề tài: Xây dựng website bán sách bằng ASP.NET MVC5 &amp; Entity Framework.</p>
                </div>
                <div class="col-md-4">
                    <h6>Thành viên</h6>
                    <p class="mb-0">Nguyễn Tấn Phú - 23DH114527</p>
                </div>
                <div class="col-md-3">
                    <h6>Liên kết</h6>
                    <ul class="list-unstyled mb-0">
                        <li>@Html.ActionLink("Trang chủ", "Index", "Home", new { area = "" }, null)</li>
                        <li>@Html.ActionLink("Giỏ hàng", "Index", "Cart", new { area = "" }, null)</li>
                        <li>@Html.ActionLink("Lịch sử mua hàng", "MyOrder", "Order", new { area = "" }, null)</li>
                    </ul>
                </div>
            </div>
            <p class="copyright">&copy; @DateTime.Now.Year FASTOR Books</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        // Nut cuon cho slider san pham
        document.querySelectorAll('[data-slider]').forEach(function (wrap) {
            var track = wrap.querySelector('.slider-track');
            wrap.querySelectorAll('[data-dir]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    track.scrollBy({ left: track.clientWidth * 0.8 * parseInt(btn.dataset.dir, 10), behavior: 'smooth' });
                });
            });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
