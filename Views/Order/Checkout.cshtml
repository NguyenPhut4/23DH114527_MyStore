@model NguyenTanPhu_23DH114527.Models.ViewModel.CheckoutVM
@using NguyenTanPhu_23DH114527.Models
@{
    ViewBag.Title = "Thanh toán";
}

<h1 class="h3 mb-3">Thanh toán</h1>

@using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { id = "checkoutForm" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="panel mb-3">
                <h2 class="h5">Giao tới</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ReceiverName, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ReceiverName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ReceiverName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ReceiverPhone, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ReceiverPhone, new { @class = "form-control", type = "tel" })
                        @Html.ValidationMessageFor(m => m.ReceiverPhone, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12">
                        @Html.LabelFor(m => m.ShippingAddress, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-danger small" })
                        <div class="form-text">Mặc định lấy từ thông tin tài khoản, bạn có thể sửa cho đơn này.</div>
                    </div>
                </div>
            </div>

            <div class="panel mb-3">
                <h2 class="h5">Hình thức giao hàng</h2>
                @foreach (var m in DeliveryOptions.All)
                {
                    <div class="form-check option-card">
                        <input class="form-check-input" type="radio" name="DeliveryMethod" id="dm_@m" value="@m" @(Model.DeliveryMethod == m ? "checked" : "") />
                        <label class="form-check-label" for="dm_@m">
                            @DeliveryOptions.Text(m)
                            <span class="text-muted small">· @(m == DeliveryOptions.Express ? DeliveryOptions.ExpressFee.ToString("N0") + " đ" : "30.000 đ, miễn phí cho đơn từ 300.000 đ")</span>
                        </label>
                    </div>
                }
                @Html.ValidationMessageFor(m => m.DeliveryMethod, "", new { @class = "text-danger small" })
            </div>

            <div class="panel">
                <h2 class="h5">Hình thức thanh toán</h2>
                @foreach (var m in PayMethods.All)
                {
                    <div class="form-check option-card">
                        <input class="form-check-input" type="radio" name="PaymentMethod" id="pm_@m" value="@m" @(Model.PaymentMethod == m ? "checked" : "") />
                        <label class="form-check-label" for="pm_@m">
                            @PayMethods.Text(m)
                            <span class="text-muted small">@(PayMethods.IsPrepaid(m) ? "· Đơn xử lý sau khi nhận được tiền" : "· Trả tiền khi nhận hàng")</span>
                        </label>
                    </div>
                }
                @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger small" })
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel summary-panel">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Đơn hàng</h2>
                    @Html.ActionLink("Thay đổi", "Index", "Cart")
                </div>
                <ul class="list-unstyled order-lines my-3">
                    @foreach (var line in Model.Lines)
                    {
                        <li>
                            <span>@line.Quantity × @line.Book.Title</span>
                            <span class="text-nowrap">@line.LineTotal.ToString("N0") đ</span>
                        </li>
                    }
                </ul>

                <label class="form-label small mb-1" for="CouponCode">Mã giảm giá</label>
                <div class="input-group">
                    @Html.TextBoxFor(m => m.CouponCode, new { @class = "form-control text-uppercase", placeholder = "VD: WELCOME10" })
                    <button type="submit" name="submit" value="apply" class="btn btn-outline-secondary">Áp dụng</button>
                </div>
                @Html.ValidationMessageFor(m => m.CouponCode, "", new { @class = "text-danger small" })
                @if (!string.IsNullOrEmpty(Model.CouponMessage))
                {
                    <div class="small mt-1 @(Model.Discount > 0 ? "text-success" : "text-danger")">@Model.CouponMessage</div>
                }

                <div class="d-flex justify-content-between mt-3"><span>Tạm tính</span><span id="sumSub" data-value="@Model.SubTotal.ToString("0", System.Globalization.CultureInfo.InvariantCulture)">@Model.SubTotal.ToString("N0") đ</span></div>
                <div class="d-flex justify-content-between"><span>Phí vận chuyển</span><span id="sumFee">@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("N0") + " đ")</span></div>
                <div class="d-flex justify-content-between"><span>Giảm giá</span><span id="sumDiscount" data-value="@Model.Discount.ToString("0", System.Globalization.CultureInfo.InvariantCulture)">@(Model.Discount > 0 ? "-" + Model.Discount.ToString("N0") + " đ" : "0 đ")</span></div>
                <div class="d-flex justify-content-between mt-2 fs-5">
                    <span>Tổng tiền</span><strong class="text-danger" id="sumTotal">@Model.Total.ToString("N0") đ</strong>
                </div>
                <button type="submit" name="submit" value="order" class="btn btn-buy btn-lg w-100 mt-3">Đặt hàng</button>
            </div>
        </div>
    </div>
}

@section scripts {
    <script>
        // Cập nhật phí vận chuyển và tổng tiền ngay khi đổi hình thức giao hàng
        (function () {
            var sub = parseFloat(document.getElementById('sumSub').dataset.value);
            var discount = parseFloat(document.getElementById('sumDiscount').dataset.value) || 0;
            function fmt(n) { return n.toLocaleString('vi-VN') + ' đ'; }
            function update() {
                var sel = document.querySelector('input[name=DeliveryMethod]:checked');
                var fee = sel && sel.value === 'EXPRESS' ? 45000 : (sub >= 300000 ? 0 : 30000);
                document.getElementById('sumFee').textContent = fee === 0 ? 'Miễn phí' : fmt(fee);
                document.getElementById('sumTotal').textContent = fmt(sub + fee - discount);
            }
            document.querySelectorAll('input[name=DeliveryMethod]').forEach(function (r) { r.addEventListener('change', update); });
            update();
        })();
    </script>
}
