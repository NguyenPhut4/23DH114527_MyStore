@model NguyenTanPhu_23DH114527.Models.ViewModel.MyOrderVM
@using NguyenTanPhu_23DH114527.Models
@{
    ViewBag.Title = "Đơn hàng của tôi";
    var totalAll = Model.StatusCounts.Values.Sum();
}

@section styles {
    <link href="~/Content/myStyle/MyOrder.css" rel="stylesheet" />
}

<div class="myorder">
    <h1 class="h4 mb-3">Đơn hàng của tôi</h1>

    @if (!Model.HasAnyOrder)
    {
        <div class="empty-box">
            <p class="fw-bold mb-3">BẠN CHƯA CÓ ĐƠN HÀNG NÀO. HÃY ĐẶT ĐƠN NGAY.</p>
            @Html.ActionLink("Về trang HOME", "Index", "Home", null, new { @class = "btn btn-buy" })
        </div>
    }
    else
    {
        <nav class="order-tabs" aria-label="Lọc theo trạng thái">
            <a href="@Url.Action("MyOrder", new { searchTerm = Model.SearchTerm })" class="@(Model.Status == null ? "active" : "")">
                Tất cả đơn <span class="count">@totalAll</span>
            </a>
            @foreach (var s in OrderStatuses.All)
            {
                <a href="@Url.Action("MyOrder", new { status = s, searchTerm = Model.SearchTerm })" class="@(Model.Status == s ? "active" : "")">
                    @OrderStatuses.Text(s) <span class="count">@Model.StatusCounts[s]</span>
                </a>
            }
        </nav>

        using (Html.BeginForm("MyOrder", "Order", FormMethod.Get, new { @class = "order-search", role = "search" }))
        {
            if (Model.Status != null)
            {
                <input type="hidden" name="status" value="@Model.Status" />
            }
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
            <input type="search" name="searchTerm" value="@Model.SearchTerm" placeholder="Tìm đơn hàng theo Mã đơn hàng hoặc Tên sản phẩm" aria-label="Tìm đơn hàng" />
            <button type="submit">Tìm đơn hàng</button>
        }

        if (!Model.Groups.Any())
        {
            <div class="empty-box">
                <p class="mb-2">Không tìm thấy đơn hàng phù hợp.</p>
                @Html.ActionLink("Xem tất cả đơn", "MyOrder")
            </div>
        }

        foreach (var group in Model.Groups)
        {
            var gi = OrderStatuses.Index(group.Status);
            <section class="status-group" id="group-@gi">
                @if (Model.Status == null)
                {
                    <h2 class="status-title">@OrderStatuses.Text(group.Status) <span class="text-muted">(@group.TotalCount)</span></h2>
                }

                @foreach (var order in group.Orders)
                {
                    var items = order.OrderItems.ToList();
                    var collapseId = "more-" + order.OrderId;
                    <article class="order-card">
                        <header class="order-card-head">
                            <span class="status-label status-@gi">@order.StatusText</span>
                            <span class="text-muted small">Mã đơn #@order.OrderId · Ngày đặt @order.OrderDate.ToString("dd/MM/yyyy")</span>
                        </header>

                        @for (var i = 0; i < items.Count; i++)
                        {
                            var oi = items[i];
                            if (i == 2)
                            {
                                @:<div class="collapse" id="@collapseId">
                            }
                            @* Mỗi sách có nút MUA LẠI (số lượng = 1) và XEM CHI TIẾT (trang chi tiết của chính sách đó) *@
                            <div class="order-item">
                                <a href="@Url.Action("ProductDetail", "Home", new { id = oi.BookId })" class="order-thumb">
                                    <img src="@Url.Content(oi.Book.ImageUrl)" alt="@oi.Book.Title" />
                                    <span class="qty">x@(oi.Quantity)</span>
                                </a>
                                <div class="order-item-info">
                                    <a href="@Url.Action("ProductDetail", "Home", new { id = oi.BookId })" class="order-item-name">@oi.Book.Title</a>
                                    <div class="order-item-actions">
                                        @using (Html.BeginForm("BuyAgain", "Order", FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookId" value="@oi.BookId" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Mua lại</button>
                                        }
                                        <a href="@Url.Action("ProductDetail", "Home", new { id = oi.BookId })" class="btn btn-sm btn-outline-secondary">Xem chi tiết</a>
                                    </div>
                                </div>
                                <div class="order-item-price">@((oi.Quantity * oi.UnitPrice).ToString("N0")) đ</div>
                            </div>
                            if (i == items.Count - 1 && items.Count > 2)
                            {
                                @:</div>
                            }
                        }

                        @if (items.Count > 2)
                        {
                            <button type="button" class="btn btn-sm btn-light border more-items" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false">
                                Xem thêm @(items.Count - 2) sản phẩm
                            </button>
                        }

                        <footer class="order-card-foot">
                            <div>Tổng tiền: <strong>@order.TotalAmount.ToString("N0") đ</strong></div>
                            <div class="d-flex gap-2 flex-wrap">
                                @if (order.Status == OrderStatuses.Pending)
                                {
                                    using (Html.BeginForm("Cancel", "Order", new { id = order.OrderId }, FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Bạn chắc chắn muốn hủy đơn #@order.OrderId?')">Hủy đơn</button>
                                    }
                                }
                                @using (Html.BeginForm("BuyAgain", "Order", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <button type="submit" class="btn btn-light border btn-sm">Mua lại cả đơn</button>
                                }
                                @Html.ActionLink("Xem hóa đơn", "OrderDetail", new { id = order.OrderId }, new { @class = "btn btn-light border btn-sm" })
                            </div>
                        </footer>
                    </article>
                }

                @if (group.TotalCount > group.Orders.Count && !group.Expanded)
                {
                    <a class="see-more" href="@Url.Action("MyOrder", new { status = Model.Status, expand = group.Status, searchTerm = Model.SearchTerm })#group-@gi">
                        Xem thêm đơn "@OrderStatuses.Text(group.Status)" (@(group.TotalCount - group.Orders.Count) đơn)
                    </a>
                }
                else if (group.Expanded && group.TotalCount > group.Orders.Count)
                {
                    <p class="text-muted small">Đang hiển thị @group.Orders.Count đơn gần nhất.</p>
                }
            </section>
        }
    }
</div>
