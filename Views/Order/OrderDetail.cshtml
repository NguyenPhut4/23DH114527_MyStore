@model NguyenTanPhu_23DH114527.Models.Order
@{
    ViewBag.Title = "Hóa đơn #" + Model.OrderID;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">@Html.ActionLink("Đơn hàng của tôi", "MyOrder")</li>
        <li class="breadcrumb-item active" aria-current="page">Hóa đơn #@Model.OrderID</li>
    </ol>
</nav>

<div class="panel">
    <h1 class="h4">Hóa đơn mua hàng</h1>
    @Html.Partial("~/Views/Shared/_OrderInvoice.cshtml", Model)
</div>

<div class="d-flex gap-2 mt-3 flex-wrap">
    @using (Html.BeginForm("BuyAgain", "Order", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="orderId" value="@Model.OrderID" />
        <button type="submit" class="btn btn-buy">Mua lại</button>
    }
    @Html.ActionLink("Quay lại đơn hàng của tôi", "MyOrder", null, new { @class = "btn btn-outline-buy" })
</div>
