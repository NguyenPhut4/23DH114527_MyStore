@model NguyenTanPhu_23DH114527.Models.ViewModel.Cart
@using PagedList.Mvc

@if (Model.SimilarProducts != null && Model.SimilarProducts.TotalItemCount > 0)
{
    <section class="section-block" id="similar">
        <div class="section-head">
            <h2>Sản phẩm tương tự</h2>
            <span class="text-muted">Cùng danh mục với sản phẩm trong giỏ</span>
        </div>
        <div class="product-grid grid-4">
            @foreach (var p in Model.SimilarProducts)
            {
                @Html.Partial("~/Views/Shared/_ProductCard.cshtml", p)
            }
        </div>
        <div class="pager-wrap">
            @Html.PagedListPager(Model.SimilarProducts, page => Url.Action("Index", new { page }) + "#similar")
        </div>
    </section>
}
