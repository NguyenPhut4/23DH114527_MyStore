@model NguyenTanPhu_23DH114527.Models.ViewModel.Cart
@{
    ViewBag.Title = "Giỏ hàng";
    var allSelected = Model.Items.Any() && Model.Items.All(i => i.Selected);
}

<h1 class="h3 mb-3">Giỏ hàng <small class="text-muted fs-6">(@Model.TotalQuantity sản phẩm)</small></h1>

@if (Model.IsEmpty)
{
    <div class="empty-box">
        <p class="mb-3">Giỏ hàng của bạn đang trống.</p>
        @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-buy" })
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="panel p-0">
                <div class="cart-head">
                    @using (Html.BeginForm("ToggleSelect", "Cart", FormMethod.Post, new { @class = "d-flex align-items-center gap-2" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="selected" value="@((!allSelected).ToString().ToLower())" />
                        <input type="checkbox" class="form-check-input mt-0" id="selectAll" @(allSelected ? "checked" : "") onchange="this.form.submit()" />
                        <label for="selectAll" class="mb-0">Chọn tất cả (@Model.Items.Count)</label>
                    }
                    @using (Html.BeginForm("ClearCart", "Cart", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-danger p-0" onclick="return confirm('Xóa toàn bộ giỏ hàng?')">Xóa tất cả</button>
                    }
                </div>

                @foreach (var group in Model.GroupedItems)
                {
                    <div class="cart-group">
                        <div class="cart-group-title">@group.Key</div>
                        @foreach (var item in group)
                        {
                            var outOfStock = item.MaxQuantity <= 0;
                            <div class="cart-row @(outOfStock ? "is-disabled" : "")">
                                @using (Html.BeginForm("ToggleSelect", "Cart", FormMethod.Post, new { @class = "cart-check" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductID" />
                                    <input type="hidden" name="selected" value="@((!item.Selected).ToString().ToLower())" />
                                    <input type="checkbox" class="form-check-input" aria-label="Chọn mua @item.ProductName"
                                           @(item.Selected ? "checked" : "") @(outOfStock ? "disabled" : "") onchange="this.form.submit()" />
                                }
                                <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="cart-thumb">
                                    <img src="@Url.Content(item.ProductImage)" alt="@item.ProductName" />
                                </a>
                                <div class="cart-info">
                                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="fw-semibold">@item.ProductName</a>
                                    <div class="text-muted small">Đơn giá: @item.UnitPrice.ToString("N0") đ</div>
                                    @if (outOfStock)
                                    {
                                        <div class="text-danger small">Sản phẩm đã hết hàng</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">Còn @item.MaxQuantity trong kho</div>
                                    }
                                </div>
                                @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "cart-qty" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductID" />
                                    <div class="qty-control qty-sm">
                                        <button type="submit" name="setQuantity" value="@(item.Quantity - 1)" @(item.Quantity <= 1 ? "disabled" : "") aria-label="Giảm">−</button>
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" max="@Math.Max(1, item.MaxQuantity)"
                                               onchange="this.form.submit()" aria-label="Số lượng" />
                                        <button type="submit" name="setQuantity" value="@(item.Quantity + 1)" @(item.Quantity >= item.MaxQuantity ? "disabled" : "") aria-label="Tăng">+</button>
                                    </div>
                                }
                                <div class="cart-total">@item.TotalPrice.ToString("N0") đ</div>
                                @using (Html.BeginForm("RemoveFromCart", "Cart", FormMethod.Post, new { @class = "cart-remove" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductID" />
                                    <button type="submit" class="btn btn-link text-danger p-0" aria-label="Xóa @item.ProductName">Xóa</button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel summary-panel">
                <h2 class="h5">Tính tiền</h2>
                <div class="d-flex justify-content-between">
                    <span>Sản phẩm đã chọn</span><span>@Model.SelectedQuantity</span>
                </div>
                <div class="d-flex justify-content-between mt-2 fs-5">
                    <span>Tổng tiền</span><strong class="text-danger">@Model.SelectedTotal.ToString("N0") đ</strong>
                </div>
                @if (Model.SelectedItems.Any())
                {
                    @Html.ActionLink("Mua hàng (" + Model.SelectedQuantity + ")", "Checkout", "Order", null, new { @class = "btn btn-buy btn-lg w-100 mt-3" })
                }
                else
                {
                    <p class="text-muted small mt-3 mb-0">Hãy chọn sản phẩm để mua hàng.</p>
                }
                @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-outline-buy w-100 mt-2" })
            </div>
        </div>
    </div>

    @Html.Partial("_PVSimilarProduct", Model)
}
