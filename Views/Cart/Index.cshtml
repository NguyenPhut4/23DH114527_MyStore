@model NguyenTanPhu_23DH114527.Models.ViewModel.CartVM
@{
    ViewBag.Title = "Giỏ hàng";
}

<h1 class="h3 mb-3">Giỏ hàng <small class="text-muted fs-6">(@Model.TotalQuantity cuốn)</small></h1>

@if (Model.IsEmpty)
{
    <div class="empty-box">
        <p class="mb-3">Giỏ hàng của bạn đang trống.</p>
        @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-buy" })
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="panel p-0">
                <div class="cart-head">
                    <label class="mb-0"><input type="checkbox" id="pickAll" class="form-check-input me-2" checked />Chọn tất cả (@Model.Lines.Count)</label>
                    @using (Html.BeginForm("ClearCart", "Cart", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-danger p-0" onclick="return confirm('Xóa toàn bộ giỏ hàng?')">Xóa tất cả</button>
                    }
                </div>

                @foreach (var group in Model.Grouped)
                {
                    <div class="cart-group">
                        <div class="cart-group-title">@group.Key</div>
                        @foreach (var line in group)
                        {
                            var book = line.Book;
                            <div class="cart-row @(line.Available ? "" : "is-disabled")">
                                <input type="checkbox" class="form-check-input cart-pick" value="@book.BookId" data-qty="@line.Quantity" data-total="@line.LineTotal.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" aria-label="Chọn @book.Title" @(line.Available ? "checked" : "disabled") />
                                <a href="@Url.Action("ProductDetail", "Home", new { id = book.BookId })" class="cart-thumb">
                                    <img src="@Url.Content(book.ImageUrl)" alt="@book.Title" />
                                </a>
                                <div class="cart-info">
                                    <a href="@Url.Action("ProductDetail", "Home", new { id = book.BookId })" class="fw-semibold">@book.Title</a>
                                    <div class="text-muted small">@book.AuthorNames</div>
                                    <div class="text-muted small">Đơn giá: @book.Price.ToString("N0") đ</div>
                                    @if (!book.IsActive || book.StockQuantity <= 0)
                                    {
                                        <div class="text-danger small">Sách đã hết hàng hoặc ngừng kinh doanh</div>
                                    }
                                    else if (!line.Available)
                                    {
                                        <div class="text-danger small">Chỉ còn @book.StockQuantity cuốn, hãy giảm số lượng</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">Còn @book.StockQuantity cuốn trong kho</div>
                                    }
                                </div>
                                @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "cart-qty" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@book.BookId" />
                                    <div class="qty-control qty-sm">
                                        <button type="submit" name="setQuantity" value="@(line.Quantity - 1)" @(line.Quantity <= 1 ? "disabled" : "") aria-label="Giảm">−</button>
                                        <input type="number" name="quantity" value="@line.Quantity" min="1" max="@Math.Max(1, book.StockQuantity)" onchange="this.form.submit()" aria-label="Số lượng" />
                                        <button type="submit" name="setQuantity" value="@(line.Quantity + 1)" @(line.Quantity >= book.StockQuantity ? "disabled" : "") aria-label="Tăng">+</button>
                                    </div>
                                }
                                <div class="cart-total">@line.LineTotal.ToString("N0") đ</div>
                                @using (Html.BeginForm("RemoveFromCart", "Cart", FormMethod.Post, new { @class = "cart-remove" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@book.BookId" />
                                    <button type="submit" class="btn btn-link text-danger p-0" aria-label="Xóa @book.Title">Xóa</button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel summary-panel">
                <h2 class="h5">Tính tiền</h2>
                <div class="d-flex justify-content-between"><span>Đã chọn</span><span><span id="selQty">@Model.TotalQuantity</span> cuốn</span></div>
                <div class="d-flex justify-content-between mt-2 fs-5">
                    <span>Tạm tính</span><strong class="text-danger"><span id="selTotal">@Model.SubTotal.ToString("N0")</span> đ</strong>
                </div>
                <p class="text-muted small mt-2 mb-0">Tick các sách muốn mua; sách không chọn vẫn ở lại trong giỏ. Phí vận chuyển và mã giảm giá được tính ở bước thanh toán.</p>
                @if (!Model.AllAvailable)
                {
                    <div class="alert alert-warning small mt-3 mb-0">Sách không đủ hàng bị bỏ chọn. Hãy giảm số lượng hoặc xóa khỏi giỏ.</div>
                }
                <a id="btnCheckout" href="@Url.Action("Checkout", "Order")" data-base="@Url.Action("Checkout", "Order")" class="btn btn-buy btn-lg w-100 mt-3">Mua hàng</a>
                @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-outline-buy w-100 mt-2" })
            </div>
        </div>
    </div>

    @Html.Partial("_PVSimilarBook", Model)
}

@section scripts {
    <script>
        (function () {
            var picks = Array.prototype.slice.call(document.querySelectorAll('.cart-pick'));
            var all = document.getElementById('pickAll'), btn = document.getElementById('btnCheckout');
            function fmt(n) { return n.toLocaleString('vi-VN'); }
            function sync() {
                var qty = 0, total = 0, ids = [];
                picks.forEach(function (p) {
                    if (p.checked) { qty += +p.dataset.qty; total += +p.dataset.total; ids.push(p.value); }
                });
                document.getElementById('selQty').textContent = qty;
                document.getElementById('selTotal').textContent = fmt(total);
                btn.textContent = 'Mua hàng (' + qty + ')';
                btn.href = btn.dataset.base + '?ids=' + ids.join(',');
                btn.classList.toggle('disabled', ids.length === 0);
                all.checked = ids.length > 0 && ids.length === picks.filter(function (p) { return !p.disabled; }).length;
            }
            picks.forEach(function (p) { p.addEventListener('change', sync); });
            all.addEventListener('change', function () { picks.forEach(function (p) { if (!p.disabled) p.checked = all.checked; }); sync(); });
            sync();
        })();
    </script>
}
