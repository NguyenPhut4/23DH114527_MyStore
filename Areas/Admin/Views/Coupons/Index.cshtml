@model List<NguyenTanPhu_23DH114527.Models.Coupon>
@{ ViewBag.Title = "Coupon"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2 class="page-title mb-0">Mã giảm giá</h2>
    @Html.ActionLink("Thêm coupon", "Create", null, new { @class = "btn btn-primary" })
</div>
<div class="table-responsive mt-3">
    <table class="table table-admin align-middle">
        <thead><tr><th>Mã</th><th>Giảm</th><th>Đơn tối thiểu</th><th>Thời hạn</th><th>Đã dùng</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><strong>@c.Code</strong></td>
                    <td>@c.DiscountPercent%@(c.MaxDiscount.HasValue ? " (tối đa " + c.MaxDiscount.Value.ToString("N0") + " đ)" : "")</td>
                    <td>@c.MinOrderAmount.ToString("N0") đ</td>
                    <td>@c.StartDate.ToString("dd/MM/yyyy") – @c.EndDate.ToString("dd/MM/yyyy")</td>
                    <td>@c.UsedCount / @c.UsageLimit</td>
                    <td>@(c.IsUsable ? "Đang dùng được" : (c.IsActive ? "Hết hạn / hết lượt" : "Đã tắt"))</td>
                    <td class="text-nowrap">
                        @Html.ActionLink("Sửa", "Edit", new { id = c.CouponId }) |
                        @using (Html.BeginForm("Delete", "Coupons", new { id = c.CouponId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Xóa coupon " + c.Code + "?');" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link p-0 align-baseline">Xóa</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
