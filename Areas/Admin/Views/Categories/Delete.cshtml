@model NguyenTanPhu_23DH114527.Models.Category
@{ ViewBag.Title = "Xóa danh mục"; int books = ViewBag.BookCount; int kids = ViewBag.ChildCount; }
<h2 class="page-title">Xóa danh mục</h2>
@if (books > 0 || kids > 0)
{
    <div class="alert alert-warning" style="max-width:640px">Danh mục "@Model.CategoryName" còn @books cuốn sách và @kids danh mục con nên <strong>không thể xóa</strong>.</div>
}
else
{
    <div class="alert alert-danger" style="max-width:640px">Xóa danh mục "@Model.CategoryName"?</div>
}
@using (Html.BeginForm("Delete", "Categories", new { id = Model.CategoryId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    if (books == 0 && kids == 0) { <button type="submit" class="btn btn-danger">Xóa</button> }
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
}
