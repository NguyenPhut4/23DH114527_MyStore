@model NguyenTanPhu_23DH114527.Models.Category
@{
    ViewBag.Title = "Xóa danh mục";
}

<h2 class="page-title">Xóa danh mục</h2>

@if (Model.Products.Any())
{
    <div class="alert alert-warning">
        Danh mục này đang có <strong>@Model.Products.Count</strong> sản phẩm. Hãy chuyển hoặc xóa các sản phẩm đó trước.
    </div>
}
else
{
    <h5>Bạn có chắc muốn xóa danh mục này?</h5>
}

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CategoryID)</dt>
    <dd class="col-sm-10">@Model.CategoryID</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CategoryName)</dt>
    <dd class="col-sm-10">@Model.CategoryName</dd>
</dl>

@using (Html.BeginForm("Delete", "Categories", new { id = Model.CategoryID }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    if (!Model.Products.Any())
    {
        <button type="submit" class="btn btn-danger">Xóa</button>
    }
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
}
