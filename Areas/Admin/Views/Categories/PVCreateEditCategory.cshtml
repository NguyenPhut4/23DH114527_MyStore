@model NguyenTanPhu_23DH114527.Models.Category
@Html.AntiForgeryToken()
@Html.HiddenFor(m => m.CategoryId)
@Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
<div style="max-width:640px">
    <div class="mb-3">
        @Html.LabelFor(m => m.CategoryName, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.CategoryName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.CategoryName, "", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.ParentId, new { @class = "form-label" })
        @Html.DropDownList("ParentId", (SelectList)ViewBag.ParentList, "-- Danh mục gốc --", new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.ParentId, "", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.Description, new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Description, 3, 40, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
    </div>
</div>
