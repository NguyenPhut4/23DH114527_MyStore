@model NguyenTanPhu_23DH114527.Models.Category
@{
    ViewBag.Title = "Thêm danh mục";
}

<h2 class="page-title">Thêm danh mục</h2>

@using (Html.BeginForm("Create", "Categories", FormMethod.Post))
{
    @Html.Partial("PVCreateEditCategory", Model)
    <div class="offset-md-2">
        <button type="submit" class="btn btn-primary">Lưu</button>
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
