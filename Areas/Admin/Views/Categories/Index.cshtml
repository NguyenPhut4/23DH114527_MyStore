@model IEnumerable<NguyenTanPhu_23DH114527.Models.Category>
@{
    ViewBag.Title = "Danh mục sản phẩm";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2 class="page-title flex-grow-1">Danh sách danh mục</h2>
    @Html.ActionLink("+ Thêm danh mục", "Create", null, new { @class = "btn btn-primary" })
</div>

@if (!Model.Any())
{
    <p class="empty-result">KHÔNG CÓ</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-admin">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>@Html.DisplayNameFor(m => m.CategoryName)</th>
                    <th>Tổng số hàng hóa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CategoryID</td>
                        <td>@Html.DisplayFor(m => item.CategoryName)</td>
                        <td>@item.Products.Count sản phẩm (@item.Products.Sum(p => p.Quantity) cuốn tồn)</td>
                        <td class="text-end text-nowrap">
                            @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn btn-sm btn-info" })
                            @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-sm btn-warning" })
                            @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-sm btn-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
