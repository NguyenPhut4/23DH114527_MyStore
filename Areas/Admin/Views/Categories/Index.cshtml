@model List<NguyenTanPhu_23DH114527.Models.Category>
@{
    ViewBag.Title = "Danh mục";
    var counts = (Dictionary<int, int>)ViewBag.BookCounts;
    Func<int, int> countOf = id => counts.ContainsKey(id) ? counts[id] : 0;
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2 class="page-title mb-0">Danh mục sách</h2>
    @Html.ActionLink("Thêm danh mục", "Create", null, new { @class = "btn btn-primary" })
</div>
<div class="table-responsive mt-3">
    <table class="table table-admin">
        <thead><tr><th>Danh mục</th><th>Mô tả</th><th>Số sách</th><th></th></tr></thead>
        <tbody>
            @foreach (var root in Model.Where(c => c.ParentId == null).OrderBy(c => c.CategoryName))
            {
                var kids = Model.Where(c => c.ParentId == root.CategoryId).OrderBy(c => c.CategoryName).ToList();
                <tr class="table-light fw-semibold">
                    <td>@root.CategoryName</td><td>@root.Description</td>
                    <td>@(countOf(root.CategoryId) + kids.Sum(k => countOf(k.CategoryId)))</td>
                    <td class="text-nowrap">@Html.ActionLink("Sửa", "Edit", new { id = root.CategoryId }) | @Html.ActionLink("Xóa", "Delete", new { id = root.CategoryId })</td>
                </tr>
                foreach (var k in kids)
                {
                    <tr>
                        <td class="ps-4">↳ @k.CategoryName</td><td>@k.Description</td><td>@countOf(k.CategoryId)</td>
                        <td class="text-nowrap">@Html.ActionLink("Sửa", "Edit", new { id = k.CategoryId }) | @Html.ActionLink("Xóa", "Delete", new { id = k.CategoryId })</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
