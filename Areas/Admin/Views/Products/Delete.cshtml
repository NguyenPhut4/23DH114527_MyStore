@model NguyenTanPhu_23DH114527.Models.Product
@{
    ViewBag.Title = "Xóa sản phẩm";
}

<h2 class="page-title">Xóa sản phẩm</h2>
<h5>Bạn có chắc muốn xóa sản phẩm này?</h5>

@Html.Partial("~/Views/Shared/_ProductInfo.cshtml", Model)

@using (Html.BeginForm("Delete", "Products", new { id = Model.ProductID }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="mt-3">
        <button type="submit" class="btn btn-danger">Xóa</button>
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
    </div>
}
