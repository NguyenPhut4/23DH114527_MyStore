@model NguyenTanPhu_23DH114527.Models.Order
@{
    ViewBag.Title = "Cập nhật trạng thái đơn hàng";
}

<h2 class="page-title">Cập nhật trạng thái đơn hàng #@Model.OrderID</h2>

<p>
    Khách hàng: <strong>@Model.Customer.CustomerName</strong> ·
    Ngày đặt: <strong>@Model.OrderDate.ToString("dd/MM/yyyy")</strong> ·
    Tổng giá trị: <strong>@Model.TotalAmount.ToString("N0") đ</strong>
</p>

@using (Html.BeginForm("UpdateStatus", "Orders", new { id = Model.OrderID }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="row g-3" style="max-width: 640px">
        <div class="col-md-6">
            <label class="form-label" for="orderStatus">Trạng thái đơn</label>
            @Html.DropDownList("orderStatus", (SelectList)ViewBag.OrderStatusList, new { @class = "form-select" })
            @Html.ValidationMessage("OrderStatus", "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6">
            <label class="form-label" for="paymentStatus">Trạng thái thanh toán</label>
            @Html.DropDownList("paymentStatus", (SelectList)ViewBag.PaymentStatusList, new { @class = "form-select" })
            @Html.ValidationMessage("PaymentStatus", "", new { @class = "text-danger" })
        </div>
    </div>
    <p class="text-muted small mt-2">Chuyển sang "Đã hủy" sẽ trả số lượng sản phẩm về kho.</p>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Lưu</button>
        @Html.ActionLink("Quay lại chi tiết", "DetailedOrder", new { id = Model.OrderID }, new { @class = "btn btn-secondary" })
    </div>
}
