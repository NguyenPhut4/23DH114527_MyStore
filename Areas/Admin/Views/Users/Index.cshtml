@model NguyenTanPhu_23DH114527.Models.ViewModel.UserSearchVM
@using PagedList.Mvc
@{ ViewBag.Title = "Tài khoản"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2 class="page-title mb-0">Tài khoản quản trị &amp; nhân viên</h2>
    @Html.ActionLink("Thêm tài khoản", "Create", null, new { @class = "btn btn-primary" })
</div>
@using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "row g-2 my-2" }))
{
    <div class="col-md-4">@Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Tên, tài khoản, email" })</div>
    <div class="col-auto"><button class="btn btn-primary">Tìm kiếm</button> @Html.ActionLink("Xóa lọc", "Index", null, new { @class = "btn btn-outline-secondary" })</div>
}
@if (Model.Users.TotalItemCount == 0) { <p class="empty-result">KHÔNG CÓ</p> }
else
{
    <div class="table-responsive">
        <table class="table table-admin">
            <thead><tr><th>Tài khoản</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr><td>@u.Username</td><td>@u.FullName</td><td>@u.Email</td><td>@NguyenTanPhu_23DH114527.Models.UserRoles.Text(u.Role)</td><td>@(u.IsActive ? "Hoạt động" : "Đã khóa")</td>
                        <td class="text-nowrap">@Html.ActionLink("Sửa", "Edit", new { id = u.UserId }) | @Html.ActionLink("Xóa", "Delete", new { id = u.UserId })</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.PagedListPager(Model.Users, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm }))
}
