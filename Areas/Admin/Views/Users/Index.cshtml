@model NguyenTanPhu_23DH114527.Models.ViewModel.UserSearchVM
@using PagedList.Mvc
@{
    ViewBag.Title = "Tài khoản quản trị";
}

@using (Html.BeginForm("Index", "Users", FormMethod.Get))
{
    <div class="row g-3 align-items-end mt-1">
        <div class="col-md-4">
            @Html.LabelFor(m => m.SearchTerm, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control" })
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            @Html.ActionLink("Xóa lọc", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
    <h2 class="page-title flex-grow-1">Danh sách tài khoản quản trị</h2>
    @Html.ActionLink("+ Thêm tài khoản", "Create", null, new { @class = "btn btn-primary" })
</div>

@if (Model.Users.TotalItemCount == 0)
{
    <p class="empty-result">KHÔNG CÓ</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-admin">
            <thead>
                <tr>
                    <th>Tên đăng nhập</th>
                    <th>Vai trò</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>
                            @u.Username
                            @if (u.Username == (string)Session["Username"])
                            {
                                <span class="badge bg-success ms-1">Đang đăng nhập</span>
                            }
                        </td>
                        <td>Quản trị viên</td>
                        <td class="text-end text-nowrap">
                            @Html.ActionLink("Đổi mật khẩu", "Edit", new { id = u.Username }, new { @class = "btn btn-sm btn-warning" })
                            @Html.ActionLink("Xóa", "Delete", new { id = u.Username }, new { @class = "btn btn-sm btn-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @Html.PagedListPager(Model.Users, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm }))
}
