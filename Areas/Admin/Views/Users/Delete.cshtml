@model NguyenTanPhu_23DH114527.Models.User
@{ ViewBag.Title = "Xóa tài khoản"; }
<h2 class="page-title">Xóa tài khoản</h2>
<div class="alert alert-danger" style="max-width:640px">Xóa tài khoản <strong>@Model.Username</strong> (@Model.FullName)? Tài khoản đã phát sinh dữ liệu sẽ không xóa được.</div>
@using (Html.BeginForm("Delete", "Users", new { id = Model.UserId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Xóa</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
}
