@model NguyenTanPhu_23DH114527.Models.ViewModel.LoginVM
@{
    ViewBag.Title = "Đăng nhập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - FASTOR Admin</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/admin.css" rel="stylesheet" />
</head>
<body class="admin login-page">
    <div class="login-card card shadow-sm">
        <div class="card-body p-4">
            <div class="admin-logo text-center mb-3">FA<span>S</span>TOR</div>
            <h1 class="h5 text-center mb-4">Đăng nhập quản trị</h1>
            @using (Html.BeginForm("Login", "Account", new { area = "Admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="mb-3">
                    @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>
                <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
            }
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>
