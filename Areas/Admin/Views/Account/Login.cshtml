@model NguyenTanPhu_23DH114527.Models.ViewModel.LoginVM
@{
    ViewBag.Title = "Đăng nhập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - Hiên Sách Admin</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/admin.css" rel="stylesheet" />
</head>
<body class="admin login-page">
    <div class="login-card card shadow-sm">
        <div class="card-body p-4">
            <div class="admin-logo admin-logo-lg mb-3"><svg class="brand-mark" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M3 9 L5 4 H19 L21 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M3 9 q2.25 3 4.5 0 q2.25 3 4.5 0 q2.25 3 4.5 0 q2.25 3 4.5 0" fill="none" stroke="#e85d04" stroke-width="2" stroke-linecap="round"/><path d="M6 12 V20 H18 V12 M10 20 v-5 h4 v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>Hiên <span>Sách</span></div>
            <h1 class="h5 text-center mb-4">Đăng nhập quản trị</h1>
            @using (Html.BeginForm("Login", "Account", new { area = "Admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="mb-3">
                    @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>
                <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
            }
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>
