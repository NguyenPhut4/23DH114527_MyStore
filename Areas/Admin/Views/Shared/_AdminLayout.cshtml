<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Hiên Sách Admin</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/admin.css" rel="stylesheet" />
    <link href="~/Content/invoice.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="admin">
    <nav class="navbar navbar-expand-md navbar-dark bg-dark admin-navbar">
        <div class="container-fluid px-4">
            <a class="navbar-brand admin-logo" href="@Url.Action("Index", "Home", new { area = "Admin" })"><svg class="brand-mark" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M3 9 L5 4 H19 L21 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M3 9 q2.25 3 4.5 0 q2.25 3 4.5 0 q2.25 3 4.5 0 q2.25 3 4.5 0" fill="none" stroke="#e85d04" stroke-width="2" stroke-linecap="round"/><path d="M6 12 V20 H18 V12 M10 20 v-5 h4 v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>Hiên <span>Sách</span></a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#adminNav"
                    aria-controls="adminNav" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">@Html.ActionLink("HomeAdmin", "Index", "Home", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    @* Sub-menu Quan ly danh muc: gom cac bang phu *@
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Danh mục</a>
                        <ul class="dropdown-menu">
                            <li><h6 class="dropdown-header">Quản lý danh mục</h6></li>
                            <li>@Html.ActionLink("Danh mục sản phẩm", "Index", "Categories", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("Thêm danh mục", "Create", "Categories", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                        </ul>
                    </li>
                    @* Sub-menu Quan ly hang hoa: Product + Product Detail + kho *@
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Sản phẩm</a>
                        <ul class="dropdown-menu">
                            <li><h6 class="dropdown-header">Quản lý hàng hóa</h6></li>
                            <li>@Html.ActionLink("Danh sách sản phẩm", "Index", "Products", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("Thêm sản phẩm", "Create", "Products", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>@Html.ActionLink("Quản lý kho hàng", "Stock", "Products", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                        </ul>
                    </li>
                    <li class="nav-item">@Html.ActionLink("Khách hàng", "Index", "Customers", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Đơn hàng", "Index", "Orders", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Tài khoản", "Index", "Users", new { area = "Admin" }, new { @class = "nav-link" })</li>
                </ul>
                @if (Session["Username"] != null)
                {
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Xin chào, @Session["Username"]
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>@Html.ActionLink("Đăng xuất", "Logout", "Account", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <main class="container-fluid px-4 py-3 admin-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="admin-footer">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
            <p class="mb-0">&copy; @DateTime.Now.Year - Hiên Sách Admin</p>
            <div class="text-end">
                <h5 class="mb-1">Contact</h5>
                <p class="mb-0">Nguyễn Tấn Phú - 23DH114527</p>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
