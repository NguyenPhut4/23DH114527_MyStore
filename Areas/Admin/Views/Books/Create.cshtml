@model NguyenTanPhu_23DH114527.Models.Book
@{
    ViewBag.Title = "Thêm sách";
}

<h2 class="page-title">Thêm sách</h2>

@using (Html.BeginForm("Create", "Books", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.Partial("PVCreateEditBook", Model)
