@model NguyenTanPhu_23DH114527.Models.Customer
@{
    ViewBag.Title = "Chi tiết khách hàng";
}

<h2 class="page-title">Thông tin khách hàng</h2>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CustomerID)</dt>
    <dd class="col-sm-10">@Model.CustomerID</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CustomerName)</dt>
    <dd class="col-sm-10">@Model.CustomerName</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CustomerPhone)</dt>
    <dd class="col-sm-10">@Model.CustomerPhone</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CustomerEmail)</dt>
    <dd class="col-sm-10">@Model.CustomerEmail</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CustomerAddress)</dt>
    <dd class="col-sm-10">@Model.CustomerAddress</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Username)</dt>
    <dd class="col-sm-10">@Model.Username</dd>
</dl>

<h2 class="page-title">Danh sách đơn hàng (@Model.Orders.Count)</h2>
@Html.Partial("~/Areas/Admin/Views/Orders/PVOrderList.cshtml", Model.Orders.OrderByDescending(o => o.OrderDate).ThenByDescending(o => o.OrderID).ToList())

@Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
