@model NguyenTanPhu_23DH114527.Models.ViewModel.UserSearchVM
@using PagedList.Mvc
@{
    ViewBag.Title = "Khách hàng";
    Func<string, string, string> sortLink = (asc, desc) => Url.Action("Index", new { searchTerm = Model.SearchTerm, sortOrder = Model.SortOrder == asc ? desc : asc });
}
<h2 class="page-title">Khách hàng</h2>
@using (Html.BeginForm("Index", "Customers", FormMethod.Get, new { @class = "row g-2 my-2" }))
{
    <div class="col-md-4">@Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Tên, tài khoản, email, SĐT" })</div>
    <div class="col-auto"><button class="btn btn-primary">Tìm kiếm</button> @Html.ActionLink("Xóa lọc", "Index", null, new { @class = "btn btn-outline-secondary" })</div>
}
@if (Model.Users.TotalItemCount == 0) { <p class="empty-result">KHÔNG CÓ</p> }
else
{
    <div class="table-responsive">
        <table class="table table-admin">
            <thead><tr>
                <th><a href="@sortLink("name_asc", "name_desc")">Họ tên ⇅</a></th><th>Tài khoản</th><th>Email</th><th>SĐT</th>
                <th><a href="@sortLink("orders_desc", "orders_asc")">Số đơn ⇅</a></th><th>Trạng thái</th><th></th>
            </tr></thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr><td>@u.FullName</td><td>@u.Username</td><td>@u.Email</td><td>@u.PhoneNumber</td><td>@u.Orders.Count</td>
                        <td>@(u.IsActive ? "Hoạt động" : "Đã khóa")</td>
                        <td>@Html.ActionLink("Chi tiết", "Details", new { id = u.UserId })</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.PagedListPager(Model.Users, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm, sortOrder = Model.SortOrder }))
}
