@model NguyenTanPhu_23DH114527.Models.ViewModel.CustomerSearchVM
@using PagedList.Mvc
@{
    ViewBag.Title = "Khách hàng";
    Func<string, string, string> sortLink = (asc, desc) =>
        Url.Action("Index", new { searchTerm = Model.SearchTerm, sortOrder = Model.SortOrder == asc ? desc : asc });
}

@using (Html.BeginForm("Index", "Customers", FormMethod.Get))
{
    @Html.Hidden("sortOrder", Model.SortOrder)
    <div class="row g-3 align-items-end mt-1">
        <div class="col-md-5">
            @Html.LabelFor(m => m.SearchTerm, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Tên, SĐT, email hoặc tài khoản" })
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            @Html.ActionLink("Xóa lọc", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>
}

<h2 class="page-title mt-3">Danh sách khách hàng</h2>

@if (Model.Customers.TotalItemCount == 0)
{
    <p class="empty-result">KHÔNG CÓ</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-admin">
            <thead>
                <tr>
                    <th>Mã KH</th>
                    <th><a href="@sortLink("name_asc", "name_desc")">Tên khách hàng ⇅</a></th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Tài khoản</th>
                    <th><a href="@sortLink("orders_desc", "orders_asc")">Số đơn hàng ⇅</a></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    <tr>
                        <td>@c.CustomerID</td>
                        <td>@c.CustomerName</td>
                        <td>@c.CustomerPhone</td>
                        <td>@c.CustomerEmail</td>
                        <td>@c.Username</td>
                        <td>@c.Orders.Count</td>
                        <td class="text-end">@Html.ActionLink("Chi tiết", "Details", new { id = c.CustomerID }, new { @class = "btn btn-sm btn-info" })</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @Html.PagedListPager(Model.Customers, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm, sortOrder = Model.SortOrder }))
}
