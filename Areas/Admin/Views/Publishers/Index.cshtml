@model List<NguyenTanPhu_23DH114527.Models.Publisher>
@{ ViewBag.Title = "Nhà xuất bản"; var counts = (Dictionary<int, int>)ViewBag.BookCounts; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2 class="page-title mb-0">Nhà xuất bản</h2>
    @Html.ActionLink("Thêm NXB", "Create", null, new { @class = "btn btn-primary" })
</div>
<div class="table-responsive mt-3">
    <table class="table table-admin">
        <thead><tr><th>Tên NXB</th><th>Địa chỉ</th><th>Điện thoại</th><th>Số sách</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr><td>@p.PublisherName</td><td>@p.Address</td><td>@p.Phone</td><td>@(counts.ContainsKey(p.PublisherId) ? counts[p.PublisherId] : 0)</td>
                    <td class="text-nowrap">@Html.ActionLink("Sửa", "Edit", new { id = p.PublisherId }) | @Html.ActionLink("Xóa", "Delete", new { id = p.PublisherId })</td></tr>
            }
        </tbody>
    </table>
</div>
